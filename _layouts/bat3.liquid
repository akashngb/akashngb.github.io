---
layout: default
---

<div id="flash"></div>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<div class="post">
  <header class="post-header">
    <h1 class="post-title" id="name-header"></h1>
    <p class="desc" id="subtitle">{{ page.subtitle }}</p>
  </header>

  <article>
    <div class="sketchfab-embed-wrapper" style="width: 100vw; height: 100vh; margin: 0; margin-left: calc(-50vw + 50%); position: relative;">
      <iframe 
        title="batmobile armored" 
        frameborder="0" 
        allowfullscreen 
        mozallowfullscreen="true" 
        webkitallowfullscreen="true" 
        allow="autoplay; fullscreen; xr-spatial-tracking" 
        xr-spatial-tracking 
        execution-while-out-of-viewport 
        execution-while-not-rendered 
        web-share 
        allowtransparency="true"
        style="width: 100%; height: 100%; background: transparent;"
        src="https://sketchfab.com/models/sBv577Vdl9lrcvyFT3vbNvkGKml/embed?autostart=1&preload=1&transparent=1&ui_animations=0&ui_infos=0&ui_stop=0&ui_inspector=0&ui_watermark_link=0&ui_watermark=0&ui_hint=0&ui_ar=0&ui_help=0&ui_settings=0&ui_vr=0&ui_fullscreen=0&ui_annotations=0&ui_downloads=0&ui_share=0">
      </iframe>
    </div>
    <div style="display: flex; gap: 3rem; align-items: flex-start;">
      
      <!-- Main content -->
      <div style="flex: 1;">
        {{ content }}
      </div>

      <!-- Profile sidebar -->
      {% if page.profile %}
      <div style="flex-shrink: 0;">
        <img id="profile-rotator" 
            src="{{ page.profile.images[0] | relative_url }}"
            alt="profile"
            style="width: 270px; height: 360px; object-fit: cover; border-radius: 12px; margin-bottom: 20px;">
        
        <div class="profile-icons" style="display: flex; justify-content: center; gap: 16px;">
          <a href="https://open.spotify.com/user/obxzyzxv5yuu7qo1u3qaxvsqm?si=d17ead429e394d7d" target="_blank" class="profile-animated-icon">
            {% include icons/spotify-animated.svg %}
          </a>
          <a href="https://www.linkedin.com/in/akash-nagabhirava-164155327/?skipRedirect=true" target="_blank" class="profile-animated-icon">
            {% include icons/linkedin-animated.svg %}
          </a>
          <a href="https://github.com/akashngb" target="_blank" class="profile-animated-icon">
            {% include icons/github-animated.svg %}
          </a>
          <a href="https://instagram.com/akash30n" target="_blank" class="profile-animated-icon">
            {% include icons/instagram-animated.svg %}
          </a>
        </div>
      </div>
      {% endif %}

    </div>
  </article>
</div>

<!-- Fixed vertical icon bar -->
<div class="side-icons">

  <a href="https://github.com/akashngb" target="_blank" class="side-icon" aria-label="GitHub">
    {% include icons/github-animated.svg %}
  </a>

  <a href="https://www.linkedin.com/in/akash-nagabhirava-164155327/?skipRedirect=true" target="_blank" class="side-icon" aria-label="LinkedIn">
    {% include icons/linkedin-animated.svg %}
  </a>

  <a href="mailto:akash.nagabhirava@mail.utoronto.ca" class="side-icon" aria-label="Email">
    {% include icons/email-animated.svg %}
  </a>

  <a href="https://open.spotify.com/user/obxzyzxv5yuu7qo1u3qaxvsqm?si=d17ead429e394d7d" target="_blank" class="side-icon" aria-label="Spotify">
    {% include icons/spotify-animated.svg %}
  </a>

  <a href="#" class="side-icon" aria-label="Arrows">
    {% include icons/arrows-animated.svg %}
  </a>

</div>

<style>

/* Typewriter effect for name */
#name-header {
  font-family: Inter, system-ui, sans-serif;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  display: inline-block;
  border-right: 2px solid currentColor;
  color: var(--global-text-color) !important;
}

/* Subtitle styling */
#subtitle {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  opacity: 0;
  transition: opacity 0.6s ease;
  color: var(--global-text-color) !important;
}

#subtitle.subtitle-visible {
  opacity: 1;
}

/* Profile sidebar animated icons */
.profile-animated-icon svg {
  width: 36px;
  height: 36px;
  transition: transform 0.15s ease;
}

.profile-animated-icon:hover svg {
  transform: translateY(-2px);
}

footer {
  display: none !important;
}

.sketchfab-embed-wrapper {
  position: relative;
  z-index: 1;
  margin-top: -150px !important;
  height: calc(100vh + 150px) !important;
}

.post-header {
  position: relative;
  z-index: 20;
  margin-bottom: 0 !important;
  padding-bottom: 0 !important;
  background: transparent;
}

.post {
  margin-top: 0 !important;
  padding-top: 0 !important;
  background: transparent;
}

.post, article, .post-header {
  background: transparent !important;
}

footer,
.page-footer,
.site-footer,
#footer {
  display: none !important;
  margin: 0 !important;
  padding: 0 !important;
}

article {
  margin-top: 0 !important;
  padding-top: 0 !important;
  margin-bottom: 0 !important;
  padding-bottom: 0 !important;
}

.post {
  margin-bottom: 0 !important;
  padding-bottom: 0 !important;
}

html, body {
  padding-top: 0 !important;
  padding-bottom: 0 !important;
  margin: 0 !important;
  margin-bottom: 0 !important;
  background-color: white !important;
}

.navbar,
nav,
.fixed-bottom,
footer.sticky-bottom {
  display: none !important;
}

body.sticky-bottom-footer {
  padding-bottom: 0 !important;
  margin-bottom: 0 !important;
}

/* Fixed vertical icon bar */
.side-icons {
  position: fixed;
  right: 1.5rem;
  top: 50%;
  transform: translateY(-50%);
  z-index: 9999;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.4rem;
}

.side-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s ease, opacity 0.2s ease;
  opacity: 0.85;
}

/* Size the inlined SVGs in the side bar */
.side-icon svg {
  width: 38px;
  height: 38px;
  display: block;
}

.side-icon:hover {
  transform: scale(1.15) translateX(-3px);
  opacity: 1;
}

</style>

<script>
/* Live age calculation */
const birthDate = new Date("2006-12-30T02:00:00.700Z");

function computeAge() {
  const now = new Date();
  return (now - birthDate) / (365.2422 * 24*60*60*1000);
}

function updateAgeHeader() {
  const el = document.getElementById("live-age");
  if (!el) return;
  el.textContent = computeAge().toFixed(10);
}

/* Typewriter name effect */
function typeNameWithTypos(el) {
  if (!el || el.dataset.typing === "1") return;
  el.dataset.typing = "1";

  const firstName = "Akash ";
  const typos = ["Nabghirava", "Nagabhirva", "Nagabhirava"];
  
  let phase = "first";
  let firstIndex = 0;
  let stage = 0;
  let index = 0;
  let deleting = false;

  function jitter(base) {
    return Math.max(10, base + Math.floor(Math.random() * 60) - 30);
  }

  function step() {
    if (!document.body.contains(el)) {
      el.dataset.typing = "0";
      return;
    }

    if (phase === "first") {
      el.textContent = firstName.slice(0, firstIndex + 1);
      firstIndex++;
      if (firstIndex < firstName.length) {
        return setTimeout(step, jitter(110));
      }
      phase = "last";
      index = 0;
      return setTimeout(step, 200);
    }

    const target = typos[stage] || "";

    if (!deleting) {
      const visibleLast = target.slice(0, index + 1);
      el.textContent = firstName + visibleLast;
      index++;

      if (index < target.length) {
        return setTimeout(step, jitter(120));
      }

      if (stage < typos.length - 1) {
        setTimeout(() => {
          let deleteCount = (stage === 0) ? 8 : (stage === 1) ? 3 : 1;
          const visibleLen = (typos[stage] || "").length;
          deleteCount = Math.min(deleteCount, Math.max(1, visibleLen - 1));
          deleting = true;
          el.dataset.deletesLeft = String(deleteCount);
          step();
        }, 400);
        return;
      } else {
        setTimeout(() => {
          el.style.borderRight = "none";
          el.dataset.typing = "0";
          
          const subtitle = document.getElementById("subtitle");
          if (subtitle) subtitle.classList.add("subtitle-visible");
        }, 320);
        return;
      }
    } else {
      let deletesLeft = parseInt(el.dataset.deletesLeft || "0", 10);
      if (deletesLeft <= 0) {
        deleting = false;
        stage++;
        setTimeout(() => {
          const visible = el.textContent.replace(firstName, "");
          index = visible.length;
          step();
        }, 200);
        return;
      }

      const currentVisible = el.textContent.replace(firstName, "");
      const newVisible = currentVisible.slice(0, -1);
      el.textContent = firstName + newVisible;
      deletesLeft--;
      el.dataset.deletesLeft = String(deletesLeft);
      return setTimeout(step, 55);
    }
  }

  step();
}

/* Profile image rotator */
function initProfileRotator() {
  const imgEl = document.getElementById("profile-rotator");
  let images = [];
  try {
    images = JSON.parse('{{ page.profile.images | jsonify }}');
  } catch (e) {
    console.error("Image JSON failed:", e);
  }

  if (!images || images.length === 0) return;

  let idx = 0;

  document.addEventListener("keydown", function (e) {
    const active = document.activeElement;
    if (active && (active.tagName === "INPUT" || active.tagName === "TEXTAREA")) return;

    if (e.key === " ") {
      e.preventDefault();
      return;
    }

    if (/^[a-zA-Z]$/.test(e.key)) {
      idx = (idx + 1) % images.length;
      if (imgEl) imgEl.src = images[idx];
    }
  });
}

document.addEventListener("DOMContentLoaded", function () {
  updateAgeHeader();
  setInterval(updateAgeHeader, 100);

  document.body.style.setProperty("padding-bottom", "0px", "important");
  new MutationObserver(() => {
    if (document.body.style.paddingBottom !== "0px") {
      document.body.style.setProperty("padding-bottom", "0px", "important");
    }
  }).observe(document.body, { attributes: true, attributeFilter: ["style"] });
  
  const nameEl = document.getElementById("name-header");
  if (nameEl) typeNameWithTypos(nameEl);
  
  initProfileRotator();
});
</script>