<script src="https://unpkg.com/@lottiefiles/dotlottie-wc@0.9.8/dist/dotlottie-wc.js" type="module"></script>
<script src="https://cdn.jsdelivr.net/npm/@mediapipe/hands/hands.js" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js" crossorigin="anonymous"></script>
<script type="text/javascript" src="https://static.sketchfab.com/api/sketchfab-viewer-1.12.1.js"></script>

<div style="position: fixed; inset: 0; width: 100vw; height: 100vh; margin: 0; padding: 0;">

  <!-- Loading screen -->
  <div id="loading-screen">
    <dotlottie-wc src="https://lottie.host/57fc8b1f-4e6f-4613-8713-816930f1ee1c/0URiQdlZkM.lottie" style="width: 300px; height: 300px;" autoplay loop></dotlottie-wc>
  </div>

  <iframe 
    id="sketchfab-iframe"
    title="batmobile armored" 
    frameborder="0" 
    allowfullscreen 
    mozallowfullscreen="true" 
    webkitallowfullscreen="true" 
    allow="autoplay; fullscreen; xr-spatial-tracking" 
    xr-spatial-tracking 
    execution-while-out-of-viewport 
    execution-while-not-rendered 
    web-share 
    allowtransparency="true"
    style="position: absolute; inset: 0; width: 100%; height: 100%; border: none; display: block; background: transparent;">
  </iframe>

  <!-- Hand tracking canvas — above everything except loading screen -->
  <video id="hand-video" playsinline style="position:absolute;visibility:hidden;width:1px;height:1px;"></video>
  <canvas id="hand-canvas" style="position:fixed;inset:0;width:100vw;height:100vh;z-index:99998;pointer-events:none;transform:scaleX(-1);"></canvas>

  <div style="
    position: fixed;
    right: 1.5rem;
    top: 1.5rem;
    z-index: 9999;
    mix-blend-mode: difference;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 13px;
    font-weight: 400;
    color: #fff;
    letter-spacing: 0.08em;
  ">akash</div>

  <div id="social-icons" style="
    position: fixed;
    right: 1.5rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: 9999;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 1.4rem;
    mix-blend-mode: difference;
  "></div>

</div>

<script>
  setTimeout(function() {
    document.getElementById('loading-screen').classList.add('hidden');
  }, 1600);

  setTimeout(function() {
    var icons = document.getElementById('social-icons');
    icons.innerHTML = `
      <a href="https://github.com/akashngb" target="_blank" style="display: flex; align-items: center; justify-content: center; opacity: 0.85; transition: transform 0.2s ease, opacity 0.2s ease;" onmouseover="this.style.transform='scale(1.15) translateX(-3px)'; this.style.opacity='1'" onmouseout="this.style.transform='scale(1) translateX(0)'; this.style.opacity='0.85'">
        <img src="/assets/icons/github-animated.svg" alt="GitHub" style="width: 38px; height: 38px;">
      </a>
      <a href="https://www.linkedin.com/in/akash-nagabhirava-164155327/" target="_blank" style="display: flex; align-items: center; justify-content: center; opacity: 0.85; transition: transform 0.2s ease, opacity 0.2s ease;" onmouseover="this.style.transform='scale(1.15) translateX(-3px)'; this.style.opacity='1'" onmouseout="this.style.transform='scale(1) translateX(0)'; this.style.opacity='0.85'">
        <img src="/assets/icons/linkedin-animated.svg" alt="LinkedIn" style="width: 38px; height: 38px;">
      </a>
      <a href="https://devpost.com/akash30n" target="_blank" style="display: flex; align-items: center; justify-content: center; opacity: 0.85; transition: transform 0.2s ease, opacity 0.2s ease;" onmouseover="this.style.transform='scale(1.15) translateX(-3px)'; this.style.opacity='1'" onmouseout="this.style.transform='scale(1) translateX(0)'; this.style.opacity='0.85'">
        <img src="/assets/icons/devpost-animated.svg" alt="Devpost" style="width: 38px; height: 38px;">
      </a>
      <a href="mailto:akash.nagabhirava@mail.utoronto.ca" style="display: flex; align-items: center; justify-content: center; opacity: 0.85; transition: transform 0.2s ease, opacity 0.2s ease;" onmouseover="this.style.transform='scale(1.15) translateX(-3px)'; this.style.opacity='1'" onmouseout="this.style.transform='scale(1) translateX(0)'; this.style.opacity='0.85'">
        <img src="/assets/icons/email-animated.svg" alt="Email" style="width: 38px; height: 38px;">
      </a>
    `;
    icons.style.display = 'flex';
  }, 3000);
