<script>
  // ─── Sketchfab Viewer API — rotation only ──────────────────────────────────────
  let sfApi = null;
  let camEye = null, camTarget = null, camReady = false;

  // Velocity accumulator — only orbit
  let velX = 0, velY = 0;
  const DAMPING    = 0.88;
  const DEAD_ZONE  = 0.0003;
  const ORBIT_GAIN = 2.5;

  // ─── Vector math ───────────────────────────────────────────────────────────────
  function vecSub(a,b) { return [a[0]-b[0],a[1]-b[1],a[2]-b[2]]; }
  function vecLen(v) { return Math.sqrt(v[0]*v[0]+v[1]*v[1]+v[2]*v[2]); }

  function toSpherical(eye, tgt) {
    const d=vecSub(eye,tgt), r=vecLen(d);
    return { r, theta: Math.atan2(d[0],d[2]), phi: Math.asin(Math.max(-1,Math.min(1,d[1]/r))) };
  }
  function fromSpherical(tgt, r, th, ph) {
    return [tgt[0]+r*Math.sin(th)*Math.cos(ph), tgt[1]+r*Math.sin(ph), tgt[2]+r*Math.cos(th)*Math.cos(ph)];
  }

  // ─── 60fps rAF camera loop — orbit only ───────────────────────────────────────
  function cameraLoop() {
    requestAnimationFrame(cameraLoop);
    if (!sfApi || !camReady) return;
    if (Math.abs(velX) < DEAD_ZONE && Math.abs(velY) < DEAD_ZONE) return;

    const sph = toSpherical(camEye, camTarget);
    sph.theta += velX * ORBIT_GAIN;
    sph.phi   -= velY * ORBIT_GAIN;
    sph.phi = Math.max(-1.5, Math.min(1.5, sph.phi));
    camEye = fromSpherical(camTarget, sph.r, sph.theta, sph.phi);
    velX *= DAMPING;
    velY *= DAMPING;
    sfApi.setCameraLookAt(camEye, camTarget, 0);
  }
  requestAnimationFrame(cameraLoop);

  // ─── Init Sketchfab — delay camera cache so viewer settles ─────────────────────
  (function() {
    const iframe = document.getElementById('sketchfab-iframe');
    const client = new Sketchfab(iframe);
    client.init('sBv577Vdl9lrcvyFT3vbNvkGKml', {
      success: function(api) {
        sfApi = api;
        api.start(function() {
          api.setUserInteraction(false);
          // Wait for Sketchfab to fully settle on its default camera before caching
          setTimeout(function() {
            api.getCameraLookAt(function(err, cam) {
              if (!err) {
                camEye = cam.position.slice();
                camTarget = cam.target.slice();
                camReady = true;
              }
            });
          }, 2000);
        });
      },
      error: function() { console.error('Sketchfab init failed'); },
      autostart: 1, preload: 1, transparent: 1,
      ui_animations:0, ui_infos:0, ui_stop:0, ui_inspector:0,
      ui_watermark_link:0, ui_watermark:0, ui_hint:0, ui_ar:0,
      ui_help:0, ui_settings:0, ui_vr:0, ui_fullscreen:0,
      ui_annotations:0, ui_downloads:0, ui_share:0,
    });
  })();

  // ─── Hand tracking ─────────────────────────────────────────────────────────────
  const videoEl = document.getElementById('hand-video');
  const canvas  = document.getElementById('hand-canvas');
  const ctx     = canvas.getContext('2d');

  function resizeCanvas() {
    canvas.width  = window.innerWidth;
    canvas.height = window.innerHeight;
  }
  window.addEventListener('resize', resizeCanvas);
  resizeCanvas();

  // ─── Draw neon skeleton (DEEP BLUE) ────────────────────────────────────────────
  function drawNeonSkeleton(lms) {
    const c = '#0066ff';
    ctx.save();
    ctx.shadowBlur = 20;
    ctx.shadowColor = '#0088ff';
    ctx.strokeStyle = c;
    ctx.lineWidth = 3;
    const conn = [
      [0,1],[1,2],[2,3],[3,4],[0,5],[5,6],[6,7],[7,8],
      [5,9],[9,10],[10,11],[11,12],[9,13],[13,14],[14,15],[15,16],
      [13,17],[17,18],[18,19],[19,20],[0,17]
    ];
    conn.forEach(([a,b]) => {
      ctx.beginPath();
      ctx.moveTo(lms[a].x*canvas.width, lms[a].y*canvas.height);
      ctx.lineTo(lms[b].x*canvas.width, lms[b].y*canvas.height);
      ctx.stroke();
    });
    ctx.fillStyle = c;
    lms.forEach(p => {
      ctx.beginPath();
      ctx.arc(p.x*canvas.width, p.y*canvas.height, 4, 0, Math.PI*2);
      ctx.fill();
    });
    ctx.restore();
  }

  // ─── Hand gesture — any hand movement = orbit ──────────────────────────────────
  let prevPos = null;

  function onResults(results) {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    if (!results.multiHandLandmarks || !results.multiHandLandmarks.length) {
      prevPos = null;
      return;
    }
    const l = results.multiHandLandmarks[0];
    drawNeonSkeleton(l);

    // Use wrist (landmark 0) as tracking anchor — most stable point
    const cur = { x: 1 - l[0].x, y: l[0].y };
    if (prevPos) {
      velX += cur.x - prevPos.x;
      velY += cur.y - prevPos.y;
    }
    prevPos = cur;
  }

  // ─── Init MediaPipe ────────────────────────────────────────────────────────────
  const hands = new Hands({
    locateFile: f => `https://cdn.jsdelivr.net/npm/@mediapipe/hands/${f}`
  });
  hands.setOptions({ maxNumHands:1, modelComplexity:1, minDetectionConfidence:0.85, minTrackingConfidence:0.85 });
  hands.onResults(onResults);
  const cam = new Camera(videoEl, {
    onFrame: async () => { await hands.send({image:videoEl}); },
    width: 1280, height: 720
  });
  cam.start();
</script>