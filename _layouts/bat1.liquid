<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ page.title }}</title>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/GLTFLoader.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/RGBELoader.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/shaders/CopyShader.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/shaders/LuminosityHighPassShader.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/EffectComposer.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/RenderPass.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/UnrealBloomPass.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/ShaderPass.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/shaders/VignetteShader.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/shaders/GammaCorrectionShader.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/objects/Reflector.js"></script>

<style>
*{margin:0;padding:0;box-sizing:border-box}
body{background:#f5f5f5;overflow:hidden}
#three-container{width:100vw;height:100vh}
#name-overlay {
  position: fixed;
  top: 36px;
  left: 40px;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
  font-size: clamp(1.6rem, 2.8vw, 2.4rem);
  font-weight: 700;
  color: #111;
  opacity: 0;
  pointer-events: none;
  white-space: nowrap;
  z-index: 100;
  letter-spacing: -0.01em;
}
</style>
</head>
<body>
<div id="three-container"></div>
<div id="name-overlay">Akash Nagabhirava</div>

<script>
function init(){
  let visible = false;
  const nameOverlay = document.getElementById('name-overlay');

  const container = document.getElementById('three-container');
  const scene = new THREE.Scene();
  scene.background = new THREE.Color(0xf5f5f5);

  const camera = new THREE.PerspectiveCamera(35, window.innerWidth/window.innerHeight, 0.1, 1000);
  camera.position.set(4.1, 2.1, 4.9);

  const renderer = new THREE.WebGLRenderer({ antialias: true });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.outputEncoding = THREE.sRGBEncoding;
  renderer.toneMapping = THREE.ACESFilmicToneMapping;
  renderer.toneMappingExposure = 1.2;
  renderer.shadowMap.enabled = true;
  container.appendChild(renderer.domElement);

  const composer = new THREE.EffectComposer(renderer);
  composer.addPass(new THREE.RenderPass(scene, camera));
  composer.addPass(new THREE.UnrealBloomPass(
    new THREE.Vector2(window.innerWidth, window.innerHeight), 0.12, 0.4, 0.9
  ));
  composer.addPass(new THREE.ShaderPass(THREE.VignetteShader));
  composer.addPass(new THREE.ShaderPass(THREE.GammaCorrectionShader));

  new THREE.RGBELoader().load('/assets/hdri/studio_small_09_1k.hdr', (hdr) => {
    const pmrem = new THREE.PMREMGenerator(renderer);
    scene.environment = pmrem.fromEquirectangular(hdr).texture;
    hdr.dispose(); pmrem.dispose();
  }, undefined, () => {});

  const key = new THREE.DirectionalLight(0xffffff, 2.5);
  key.position.set(6,10,6); key.castShadow = true; scene.add(key);
  const fill = new THREE.DirectionalLight(0xffffff, 0.5);
  fill.position.set(-6,4,2); scene.add(fill);
  const rim = new THREE.DirectionalLight(0xffffff, 1);
  rim.position.set(0,6,-8); scene.add(rim);
  scene.add(new THREE.HemisphereLight(0xffffff, 0xcccccc, 0.25));

  const reflector = new THREE.Reflector(new THREE.PlaneGeometry(30,30), {
    textureWidth:1024, textureHeight:1024, color:0xbdbdbd, clipBias:0.003, multisample:4
  });
  reflector.rotation.x = -Math.PI/2;
  scene.add(reflector);

  const reflectionFade = new THREE.Mesh(
    new THREE.PlaneGeometry(30,30),
    new THREE.MeshPhysicalMaterial({ color:0xffffff, roughness:0.35, metalness:0, transparent:true, opacity:0.25 })
  );
  reflectionFade.rotation.x = -Math.PI/2;
  reflectionFade.position.y = 0.002;
  scene.add(reflectionFade);

  const controls = new THREE.OrbitControls(camera, renderer.domElement);
  controls.enableDamping = true;
  controls.dampingFactor = 0.07;
  controls.autoRotate = true;
  controls.autoRotateSpeed = 0.25;
  controls.zoomSpeed = 3;
  controls.target.set(0, 0.8, 0);
  controls.update();

  new THREE.GLTFLoader().load('/assets/models/batmobile_armored.glb', (gltf) => {
    const model = gltf.scene;
    model.rotation.y = Math.PI * 0.75 - Math.PI / 3;
    model.position.set(0,0,0);
    model.scale.set(1,1,1);
    model.traverse(o => {
      if (!o.isMesh) return;
      o.castShadow = o.receiveShadow = true;
      const mat = o.material;
      if (!mat) return;
      if (mat.transparent || mat.opacity < 0.95) {
        mat.transmission=0.6; mat.roughness=0.05; mat.envMapIntensity=2.5; return;
      }
      if (mat.metalness > 0.6) {
        mat.envMapIntensity=2; mat.roughness=Math.max(mat.roughness,0.2); return;
      }
      mat.clearcoat=0.6; mat.clearcoatRoughness=0.08; mat.envMapIntensity=1.6;
    });
    scene.add(model);
  }, undefined, (e) => console.error(e));

  // ── Smile emoji on a canvas plane ─────────────────────────────────
  const emojiCanvas = document.createElement('canvas');
  emojiCanvas.width = 256; emojiCanvas.height = 256;
  const ectx = emojiCanvas.getContext('2d');
  ectx.font = '200px serif';
  ectx.textAlign = 'center';
  ectx.textBaseline = 'middle';
  ectx.fillText('😊', 128, 138);

  const emojiTex = new THREE.CanvasTexture(emojiCanvas);
  const emojiMesh = new THREE.Mesh(
    new THREE.PlaneGeometry(1.2, 1.2),
    new THREE.MeshBasicMaterial({ map: emojiTex, transparent: true, opacity: 0, depthWrite: false, side: THREE.DoubleSide })
  );
  // Float above and to the right of the car, facing camera
  emojiMesh.position.set(2.5, 2.8, 2.5);
  emojiMesh.lookAt(camera.position);
  scene.add(emojiMesh);

  // ── Space toggle ───────────────────────────────────────────────────
  function show() {
    gsap.fromTo(emojiMesh.scale, { x: 0, y: 0 }, { x: 1, y: 1, duration: 0.5, ease: 'back.out(2.5)' });
    gsap.to(emojiMesh.material, { opacity: 1, duration: 0.3, ease: 'power2.out' });
    gsap.to(nameOverlay, { opacity: 1, duration: 0.5, ease: 'power2.out' });
  }

  function hide() {
    gsap.to(emojiMesh.scale, { x: 0, y: 0, duration: 0.3, ease: 'back.in(2)' });
    gsap.to(emojiMesh.material, { opacity: 0, duration: 0.2 });
    gsap.to(nameOverlay, { opacity: 0, duration: 0.3 });
  }

  window.addEventListener('keydown', e => {
    if (e.code === 'Space') {
      visible = !visible;
      if (visible) show(); else hide();
    }
  });

  // Gentle bob
  const clock = new THREE.Clock();
  function animate() {
    requestAnimationFrame(animate);
    controls.update();
    if (visible) emojiMesh.position.y = 2.8 + Math.sin(clock.getElapsedTime() * 1.2) * 0.08;
    composer.render();
  }
  animate();

  window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
    composer.setSize(window.innerWidth, window.innerHeight);
  });
}
init();
</script>
</body>
</html>