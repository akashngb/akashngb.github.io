<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Gotham — Batmobile</title>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/GLTFLoader.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/RGBELoader.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/shaders/CopyShader.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/shaders/LuminosityHighPassShader.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/EffectComposer.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/RenderPass.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/UnrealBloomPass.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/ShaderPass.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/shaders/VignetteShader.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/shaders/GammaCorrectionShader.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/objects/Reflector.js"></script>

<style>
* { margin: 0; padding: 0; box-sizing: border-box }
body { background: #000; overflow: hidden }
#three-container { width: 100vw; height: 100vh }
#hint {
  position: fixed;
  bottom: 28px;
  left: 50%;
  transform: translateX(-50%);
  font-family: 'Courier New', monospace;
  font-size: 10px;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: #aaa;
  opacity: 0.3;
  pointer-events: none;
  user-select: none;
}
#loading {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #000;
  font-family: 'Courier New', monospace;
  font-size: 11px;
  letter-spacing: 0.2em;
  color: #444;
  text-transform: uppercase;
  transition: opacity 0.8s;
  z-index: 10;
}
#loading.hidden { opacity: 0; pointer-events: none }
</style>
</head>
<body>
<div id="three-container"></div>
<div id="hint">[ space ] wireframe</div>
<div id="loading">Loading environment…</div>

<script>
function init() {
  const loadingEl = document.getElementById('loading')
  let isWireframe = false
  let loadedModel = null
  let envLoaded   = false
  let modelLoaded = false
  let envTexture  = null

  function checkReady() {
    if (envLoaded && modelLoaded) loadingEl.classList.add('hidden')
  }

  // Failsafe — dismiss loading after 6s no matter what
  setTimeout(() => loadingEl.classList.add('hidden'), 6000)

  // Failsafe — never stay stuck regardless of what fails
  setTimeout(() => loadingEl.classList.add('hidden'), 6000)

  // ─── SCENE ───────────────────────────────────────────────────────────────
  const scene = new THREE.Scene()
  scene.background = new THREE.Color(0x000000)

  // ─── CAMERA ──────────────────────────────────────────────────────────────
  const camera = new THREE.PerspectiveCamera(32, innerWidth / innerHeight, 0.1, 300)
  camera.position.set(-4, 2, -7)

  // ─── RENDERER ────────────────────────────────────────────────────────────
  const renderer = new THREE.WebGLRenderer({ antialias: true })
  renderer.setSize(innerWidth, innerHeight)
  renderer.setPixelRatio(Math.min(devicePixelRatio, 2))
  renderer.outputEncoding       = THREE.sRGBEncoding
  renderer.toneMapping          = THREE.ACESFilmicToneMapping
  renderer.toneMappingExposure  = 0.75
  renderer.shadowMap.enabled    = true
  renderer.shadowMap.type       = THREE.PCFSoftShadowMap
  renderer.physicallyCorrectLights = true
  document.getElementById('three-container').appendChild(renderer.domElement)

  // ─── POST ────────────────────────────────────────────────────────────────
  const composer = new THREE.EffectComposer(renderer)
  composer.addPass(new THREE.RenderPass(scene, camera))
  const bloom = new THREE.UnrealBloomPass(
    new THREE.Vector2(innerWidth, innerHeight), 0.35, 0.45, 0.88
  )
  composer.addPass(bloom)
  const vignette = new THREE.ShaderPass(THREE.VignetteShader)
  vignette.uniforms['offset'].value   = 0.88
  vignette.uniforms['darkness'].value = 1.55
  composer.addPass(vignette)
  composer.addPass(new THREE.ShaderPass(THREE.GammaCorrectionShader))

  // ─── HDRI — real env from Poly Haven (CC0) ───────────────────────────────
  // Other good Gotham-ish slugs to try (just swap the name):
  //   shanghai_bund_1k           neon skyline
  //   urban_alley_01_1k          dark back-alley
  //   evening_road_01_1k         moody dusk road
  //   autumn_crossing_1k         foggy bridge at dusk
  // Drop any .hdr next to this HTML file and point to it here
  const HDRI_URL = './env.hdr'

  const pmrem = new THREE.PMREMGenerator(renderer)
  pmrem.compileEquirectangularShader()

  new THREE.RGBELoader().load(
    HDRI_URL,
    hdr => {
      envTexture        = pmrem.fromEquirectangular(hdr).texture
      scene.environment = envTexture
      scene.background  = envTexture
      hdr.dispose(); pmrem.dispose()
      envLoaded = true; checkReady()
    },
    undefined,
    err => {
      console.warn('HDRI load failed:', err)
      scene.background = new THREE.Color(0x060a0f)
      envLoaded = true; checkReady()
    }
  )

  // ─── LIGHTING ────────────────────────────────────────────────────────────
  const key = new THREE.DirectionalLight(0xc8d8ff, 1.0)
  key.position.set(4, 8, 3)
  key.castShadow = true
  key.shadow.mapSize.set(2048, 2048)
  key.shadow.camera.near  = 1;  key.shadow.camera.far = 40
  key.shadow.camera.left  = key.shadow.camera.bottom = -8
  key.shadow.camera.right = key.shadow.camera.top    =  8
  scene.add(key)
  scene.add(new THREE.HemisphereLight(0x1a2030, 0x100808, 0.55))

  // ─── WET FLOOR ───────────────────────────────────────────────────────────
  const reflector = new THREE.Reflector(new THREE.PlaneGeometry(60, 60), {
    textureWidth: 1024, textureHeight: 1024, color: 0x111118,
  })
  reflector.rotation.x = -Math.PI / 2
  scene.add(reflector)

  const asphaltMat = new THREE.MeshPhysicalMaterial({
    color: 0x05080d, roughness: 0.08, metalness: 0,
    transparent: true, opacity: 0.72,
  })
  const asphalt = new THREE.Mesh(new THREE.PlaneGeometry(60, 60), asphaltMat)
  asphalt.rotation.x = -Math.PI / 2
  asphalt.position.y = 0.003
  scene.add(asphalt)

  // ─── CONTROLS ────────────────────────────────────────────────────────────
  const controls = new THREE.OrbitControls(camera, renderer.domElement)
  controls.enableDamping   = true
  controls.dampingFactor   = 0.09
  controls.autoRotate      = true
  controls.autoRotateSpeed = 0.1
  controls.zoomSpeed       = 2
  controls.target.set(0, 0.6, 0)

  // ─── WIREFRAME MATS ──────────────────────────────────────────────────────
  const whiteFillMat = new THREE.MeshBasicMaterial({
    color: 0xffffff, polygonOffset: true,
    polygonOffsetFactor: 1, polygonOffsetUnits: 1,
  })
  const wireLineMat = new THREE.MeshBasicMaterial({ color: 0x00e5ff, wireframe: true })

  function attachWireOverlay(mesh) {
    const w = new THREE.Mesh(mesh.geometry, wireLineMat)
    w.userData.isWireOverlay = true
    mesh.add(w)
  }
  function removeWireOverlays(root) {
    root.traverse(obj => {
      if (!obj.isMesh) return
      obj.children.filter(c => c.userData.isWireOverlay).forEach(o => obj.remove(o))
    })
  }

  // ─── CAR ─────────────────────────────────────────────────────────────────
  new THREE.GLTFLoader().load('/assets/models/batmobile_armored.glb', gltf => {
    const model = gltf.scene
    loadedModel = model
    model.traverse(o => {
      if (!o.isMesh) return
      o.castShadow = o.receiveShadow = true
      const m = o.material
      if (!m) return
      if (m.transparent || (m.opacity != null && m.opacity < 0.95)) {
        m.transmission = 0.7; m.roughness = 0.04; m.envMapIntensity = 3; return
      }
      if (m.metalness > 0.6) {
        m.envMapIntensity = 2.5; m.roughness = Math.max(m.roughness, 0.15); return
      }
      m.clearcoat = 1.0; m.clearcoatRoughness = 0.03; m.envMapIntensity = 2.2
    })
    const box = new THREE.Box3().setFromObject(model)
    model.position.sub(box.getCenter(new THREE.Vector3()))
    model.position.y -= new THREE.Box3().setFromObject(model).min.y
    scene.add(model)
    modelLoaded = true
    checkReady()
  })

  // ─── SPACE → WIREFRAME ───────────────────────────────────────────────────
  window.addEventListener('keydown', e => {
    if (e.code !== 'Space') return
    isWireframe = !isWireframe

    if (isWireframe) {
      bloom.strength   = 1.0
      scene.background = new THREE.Color(0x000000)
      scene.fog        = new THREE.FogExp2(0x000000, 0.018)
      reflector.visible = false
      asphalt.material.color.set(0x111111)
      asphalt.material.opacity = 1
      if (loadedModel) {
        loadedModel.traverse(obj => {
          if (!obj.isMesh || obj.userData.isWireOverlay) return
          if (!obj.userData.origMat) obj.userData.origMat = obj.material
          obj.material = whiteFillMat
          attachWireOverlay(obj)
        })
      }
    } else {
      bloom.strength   = 0.35
      scene.background = envTexture || new THREE.Color(0x000000)
      scene.fog        = null
      reflector.visible = true
      asphalt.material.color.set(0x05080d)
      asphalt.material.opacity = 0.72
      if (loadedModel) {
        loadedModel.traverse(obj => {
          if (!obj.isMesh || obj.userData.isWireOverlay) return
          if (obj.userData.origMat) obj.material = obj.userData.origMat
        })
        removeWireOverlays(loadedModel)
      }
    }
  })

  // ─── RENDER LOOP ─────────────────────────────────────────────────────────
  function animate() {
    requestAnimationFrame(animate)
    controls.update()
    composer.render()
  }
  animate()

  window.addEventListener('resize', () => {
    camera.aspect = innerWidth / innerHeight
    camera.updateProjectionMatrix()
    renderer.setSize(innerWidth, innerHeight)
    composer.setSize(innerWidth, innerHeight)
  })
}
init()
</script>
</body>
</html>