<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>49th Protocol</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }

    :root {
      --cream:#F5F0E8; --forest:#1A3A2A; --terracotta:#C2714F;
      --mint:#A8C5B0; --taupe:#B8A99A; --charcoal:#2C2C2C;
      --ink:#2C2C2C22; --white:#ffffff;
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--cream);
      color: var(--charcoal);
      overflow-x: hidden;
    }

    .brand-text {
      display: flex;
      flex-direction: column;
    }

    nav {
      max-width: 1400px; margin: 0 auto;
      padding: 2rem; display: flex; align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--ink);
    }

    .nav-brand { display: flex; align-items: center; gap: 1.5rem; }

    /* ✅ NEW LOGO STYLE */
    .logo-img {
      width: 4rem;
      height: 4rem;
      object-fit: contain;
      padding: 6px;
      border-radius: 12px;
      background: #f3eee6;
      border: 1px solid rgba(0,0,0,0.05);
    }

    .brand-name {
      font-family: 'DM Serif Display', serif;
      font-size: 3rem; font-weight: 700;
      color: var(--forest); line-height: 1;
    }

    .brand-sub {
      font-size: 0.6rem; text-transform: uppercase;
      letter-spacing: 0.2em; color: rgba(44,44,44,0.4);
      font-weight: 700; margin-top: 4px;
    }

    .nav-links {
      display: none; align-items: center; gap: 3rem;
      font-size: 0.625rem; text-transform: uppercase;
      letter-spacing: 0.3em; font-weight: 700;
      color: rgba(44,44,44,0.6);
    }
    @media(min-width:768px){ .nav-links { display: flex; } }

    .nav-links a { text-decoration: none; color: inherit; }

    .btn-forest {
      padding: 0.75rem 2rem;
      background: var(--forest); color: var(--cream);
      border-radius: 4px; cursor: pointer;
      font-weight: 700; font-size: 0.625rem;
    }
  </style>
</head>

<body>

<!-- NAV -->
<nav>
  <div class="nav-brand">
    
    <!-- ✅ REPLACED SVG WITH REAL LOGO -->
    <img src="assets/img/49thlogo.png" alt="49th Logo" class="logo-img">

    <div class="brand-text">
      <span class="brand-name">49th</span>
      <span class="brand-sub">Immigration Companion</span>
    </div>
  </div>

  <div class="nav-links">
    <a href="#how-it-works">Methodology</a>
    <a href="#features">Modules</a>
    <a href="#stories">Archive</a>
    <button class="btn-forest">Begin Journey</button>
  </div>
</nav>

</body>
</html>